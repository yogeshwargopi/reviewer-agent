# Postgres
DATABASE_URL=postgres://reviewer:reviewer@localhost:5432/reviewer

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# 32-byte key, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# GitHub App OAuth client (the app's client id and secret)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=reviewer-agent
# PEM with escaped newlines, or base64 of the PEM
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Public webhook URL. Local development fills this with a smee.io channel.
GITHUB_WEBHOOK_URL=

# Optional platform keys. An organization key in Settings overrides these.
OPENAI_API_KEY=
# OpenAI-compatible gateway. Leave unset to use https://api.openai.com/v1
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
